# Secrets and local authentication. Commit only redacted example templates.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
.netrc
credentials*.json

# Patch rejects, editor backups and machine-local settings.
*.orig
*.rej
*.bak
*.tmp
*.swp
*~
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
.direnv/
.envrc

