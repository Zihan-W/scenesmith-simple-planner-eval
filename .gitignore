*.pt
*.pth
*.ckpt
*.onnx
*.npy
*.npz
*.bundle
*.evidence.tar.gz

# Generated run artifacts. JSON configs, validation indexes, patches and HTML
# templates remain eligible for tracking; do not add extension-wide ignores.
/runs/
output/
meshcats/
logs/
/patches/
*.log
*.pdf
/*.dmd.yaml
/result.json
robot_waypoints.json
robot_plan.json
robot_plan_good.json
robot_plan_bad.json
tamp_trace.jsonl
skill_steps.jsonl
model_transcript.jsonl
checks.jsonl
candidate_selection.json
supervision.json
worker_command.json
simulation.html
simulation_good.html
simulation_bad.html
zerith_online_control.csv
zerith_online_control.html

# Optional local scene assets and generated robot meshes.
# models/21-20-10_cleaned is intentionally versioned; Zerith_Model is a submodule.
/models/scene_008/
/models/15-15-01_cleaned/
/models/zerith_drake/meshes/*.obj

# Local agent instructions and a deprecated, uncommitted prototype.
/AGENTS.md
/scripts/simulate_zerith_safe_pregrasp.py

# Documentation and experiment allowlists are kept together below.
# 新增文档或实验必须在此加入白名单；用 git check-ignore -v 检查。
# Existing tracked files remain tracked regardless of ignore rules.
/docs/*
!/docs/README.md
!/docs/CURRENT_ARCHITECTURE.md
!/docs/TAMP_MODULE.md
!/docs/BT_GENERATION_PIPELINE.md
!/docs/PICKLIFT_BT_GENERATION_MODULE.md
!/docs/QUICKSTART_ONLINE_ENV.md
!/docs/GENERIC_ONLINE_EXAMPLE.md
!/docs/CUTAMP_BUDGET_CONTRACT.md
!/docs/TAMP_REPRODUCIBILITY.md
!/docs/ZERITH_CAMERA_INVENTORY.md
!/docs/contracts/

/experiments/*
!/experiments/navigation_picklift_tamp.json
!/experiments/tamp_hierarchical_config.json
!/experiments/tamp_current_validation.json
!/experiments/cutamp/
!/experiments/inputs/
/experiments/inputs/*
!/experiments/inputs/pick_lift/
!/experiments/inputs/tamp/
/experiments/inputs/tamp/*
!/experiments/inputs/tamp/scene_overrides_reachable.yaml
!/experiments/inputs/bt_navigation_picklift/
/experiments/inputs/bt_navigation_picklift/*
!/experiments/inputs/bt_navigation_picklift/bt_tree_backed.json
